scripts/openapi-snapshot.json

# Project-local Claude Code automation scripts (PR #191). Tooling, not
# production source — kept out of the Prettier check to mirror the
# `.claude/**` entry in eslint.config.js. Without this, CI lint reports
# unformatted-style warnings on the .mjs helper scripts.
.claude/

# PR #221's CI utility workflow file landed in a state that fails
# `prettier --check`. Feature PRs cannot reformat it because
# `.github/workflows/` is on the source-scope guard's forbidden list
# (a `ci/` branch is required to touch CI config). Ignoring it in
# prettier breaks the Catch-22: feature PRs no longer inherit the
# format failure. A future `ci/` branch may format the workflow
# properly and remove this entry.
.github/workflows/update-loc-badge.yml

# Architecture artifact doc — hand/tool-authored, not subject to project
# prettier conventions (it has its own embedded styling/markup). Ignoring it
# keeps the lint job green without a churny full-file reformat that could
# re-break on the next edit.
docs/architecture/pos-pulse-live-map.html

# Vendored POS v3.5 design handoff — a design REFERENCE committed verbatim
# (prototype HTML/JSX/CSS + assets). It is the authoritative spec we measure
# against; Prettier must never reformat it (that would corrupt the design
# source). Same rationale as `_reference/` and `src/shared/api-types.ts` above.
docs/design/

# RT-217: Backend-Core OpenAPI contracts vendored VERBATIM by
# `npm run contracts:repin`. The conformance suite checks each file against its
# Backend-Core git blob SHA, so Prettier must never reformat them.
contracts/backend-core/
