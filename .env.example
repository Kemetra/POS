# All variables are optional in 001-foundation. Remove placeholder values before adding real ones.

# Sentry crash reporting DSN. Unset = crash reporting disabled (inert, no network calls).
SENTRY_DSN=

# Base URL for the SmartDataPulse (Data-Pulse-2) API. Read in the MAIN process
# (resolveApiBaseUrl); the resolved URL is dependency-injected into the HTTP
# clients and never crosses the bridge to the renderer. The real default is
# resolved in-process — do NOT hardcode an environment endpoint here. The value
# below is a non-routable placeholder; override it per environment (your real
# backend host is supplied via the local, untracked .env, never committed).
VITE_API_BASE_URL=https://example.invalid

# Electron auto-updater feed URL. Signing and update distribution are deferred to a later feature.
ELECTRON_UPDATE_FEED_URL=

# 004-operator-session — Clerk publishable key (e.g. pk_test_<base64>$).
# This is NOT a secret; it identifies the Clerk instance for client-side
# use. The Frontend API hostname is decoded from the key. Unset = sign-in
# refuses generically until configured (the app still launches and the
# /sign-in route is reachable).
CLERK_PUBLISHABLE_KEY=

# ── Feature flags (read in main; mirrored to the renderer via app:config) ──
# All default OFF (fail-closed). Truthy values: 1 | true | yes | on
# (case-insensitive). Enabling a flag in production is a per-tenant/per-branch
# decision gated by the feature's §A5 sign-off.

# 005-sales-cart — mounts the live Sale cart at /app/cart.
POS_PULSE_FEATURE_CART=
# 006-payments-tender — enables the PaymentSurface (needs cart).
POS_PULSE_FEATURE_PAYMENTS=
# 008-sale-finalization-and-receipts — enables the finalize listener + receipts UI.
POS_PULSE_FEATURE_SALE_FINALIZATION=
# 009-product-search-and-barcode-lookup — mounts the catalogue search/scan/confirm
# surface in the Sale screen. Mounted only when BOTH this and
# POS_PULSE_FEATURE_CART are on (it needs the Sale cart to receive added lines).
POS_PULSE_FEATURE_PRODUCT_SEARCH=
# RT-103 — enables the internal voucher tender at checkout. Keep OFF for the pilot:
# vouchers are excluded (RT-10 D2), so the voucher tile renders disabled. RT-79's
# sync side dead-letters any voucher-tendered sale regardless.
POS_PULSE_FEATURE_VOUCHER_TENDER=

# ── Dev-only bypasses / seeds (UNPACKAGED builds ONLY) ──
# Each is unconditionally ignored in a packaged build (`app.isPackaged`), so it
# can NEVER be activated in production by exporting the variable. Same truthy
# contract as the flags above. Set the trio together for a one-command dev
# launch of the live 009 surface (they share the `dev-tenant` scope).

# 002 — skip terminal pairing (seeds fixture pairing state).
POS_PULSE_DEV_SKIP_PAIRING=
# 004 — auto sign-in a fixture manager session (no Clerk/backend call).
POS_PULSE_DEV_SKIP_OPERATOR_SIGNIN=
# 005 — wire the R7 fixture item resolver (~5 fixture SKUs). 009's real resolver
# is the production path; this is the dev-only fixture for 005's own tests.
POS_PULSE_DEV_ITEM_RESOLVER=
# 009 — seed ~12 fixture products/barcodes into the (otherwise empty) catalogue
# so the live search/scan/confirm/add path has real rows in development.
POS_PULSE_DEV_SEED_CATALOGUE=
