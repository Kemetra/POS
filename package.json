{
  "name": "pos-pulse",
  "version": "0.1.0",
  "description": "POS terminal for the SmartDataPulse pharmacy platform",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:vite": "vite --port 5173 --strictPort",
    "dev:electron": "node scripts/dev-electron.cjs",
    "dev": "concurrently --names \"vite,electron\" -c \"cyan,yellow\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:preload": "vite build --config vite.config.preload.ts",
    "build:main": "npm run build:preload && tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "codegen:api": "tsx scripts/codegen-api.ts",
    "codegen:verify": "tsx scripts/verify-codegen.ts",
    "contracts:repin": "tsx scripts/contracts-repin.ts",
    "perf:seed": "tsx scripts/perf-seed-catalogue.ts",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "package:dir": "electron-builder --win --dir",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@tanstack/react-query": "^5.100.8",
    "argon2": "0.44.0",
    "better-sqlite3": "^12.9.0",
    "clsx": "^2.1.1",
    "node-thermal-printer": "^4.6.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.4",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "sql.js": "^1.14.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  }
}
